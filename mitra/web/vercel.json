{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo \"window.MITRA_BACKEND='$MITRA_BACKEND';\" > config.js",
  "outputDirectory": ".",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE-WITH-sakala-mitra.onrender.com/api/:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "Permissions-Policy", "value": "microphone=(self)" } ] }
  ]
}
