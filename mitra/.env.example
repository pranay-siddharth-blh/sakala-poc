# Sakala Mitra - provider keys. Copy to mitra/.env and fill what you have.
# With nothing filled, the Mitra runs on the H200 gateway (from app/.env) and the browser's own
# speech engines. Add keys and it upgrades itself on the next start.

# Google Gemini (English brain + voice; also usable for Kannada)
GEMINI_API_KEY=
GEMINI_BRAIN_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE=Kore

# Sarvam (Kannada listening + speaking)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_VOICE_KN=chaitra_kn_conversation
SARVAM_VOICE_EN=shubh_enhi_ads

# Force a provider instead of "auto" (gemini | qwen | rules for the brain;
# sarvam | gemini | qwen | browser for speech)
MITRA_BRAIN=auto
MITRA_STT=auto
MITRA_TTS=auto

# Where the Sakala POC runs (it is started automatically if down)
SAKALA_URL=http://127.0.0.1:8020
MITRA_PORT=8030
